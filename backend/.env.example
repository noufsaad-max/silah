DATABASE_URL=postgresql+psycopg2://silah:silah@localhost:5432/silah
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# --- Agent pipeline (optional -- only needed to use the REAL agents; the
#     mock adapters need nothing here) ---
# Supabase: products/runs/prospects/outreach persistence. Never commit real
# values -- get these from your Supabase project settings.
SUPABASE_URL=
SUPABASE_KEY=

# Agent 1 (Product) + Agent 3 (Outreach) -- both use langchain ChatOpenAI.
# LLM_MODEL should be a real model your LLM_API_KEY can use, e.g. gpt-4o-mini
# -- NOT the placeholder "gpt-5.6-luna" left as the code's internal default.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Only set this if LLM_MODEL is a reasoning model (o1/o3/gpt-5, etc.) that
# supports a reasoning-effort parameter. Leave blank for normal chat models
# like gpt-4o-mini -- setting it for those causes OpenAI to reject the
# request outright.
LLM_REASONING_EFFORT=

# Agent 2 (Fit/Qualification) -- uses the raw openai SDK directly, so it
# does NOT read LLM_API_KEY/OPENAI_API_KEY; it needs its own key.
SILAH_OPENAI_API_KEY=
SILAH_OPENAI_BASE_URL=

# Actually sending outreach (optional -- draft/approve work with none of
# this set; the "Send" button needs it, and fails with a clear error
# without it rather than pretending to have sent anything).
# For Gmail: SMTP_PASSWORD must be an App Password (needs 2-Step
# Verification on), not the account's normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

